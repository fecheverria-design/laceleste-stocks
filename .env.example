# ─────────────────────────────────────────────────────────────
# .env.example — copiar a .env y ajustar. Los .env reales NO se commitean.
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL (lo consume docker-compose para crear la instancia) ---
POSTGRES_USER=laceleste
POSTGRES_PASSWORD=laceleste_dev
POSTGRES_DB=laceleste_movimientos
# Puerto del HOST (5433 para no chocar con un Postgres local en 5432)
POSTGRES_PORT=5433

# --- Backend ---
NODE_ENV=development
PORT=3000

# Conexión que usa el backend (apunta al puerto del host de arriba)
DATABASE_URL=postgresql://laceleste:laceleste_dev@localhost:5433/laceleste_movimientos

# Base de datos de test (Vitest). Se crea aparte sobre la misma instancia.
DATABASE_URL_TEST=postgresql://laceleste:laceleste_dev@localhost:5433/laceleste_movimientos_test

# Depósito que despacha por defecto cuando el POST /api/abastecimientos no manda
# origen_dep_id_3c. Es el dep_id de 3c del depósito principal (regla #1).
DEPOSITO_PRINCIPAL_DEP_ID_3C=1

# Auth JWT propio (Bearer + localStorage). Generar uno real con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-de-32-bytes-minimo
JWT_EXPIRES_IN_SECONDS=28800

# API key del endpoint M2M POST /api/abastecimientos (app del compañero, header x-api-key).
# Sin esto el endpoint queda cerrado (503). Generar una real con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
M2M_API_KEY=cambiar-por-una-api-key-de-24-bytes-minimo

# --- Sync con la app del compañero (app_ordenes_produccion) ---
# PULL: leemos SU API REST y materializamos los abastecimientos como RINT.
# Lo consume `npm run sync:abastecimientos`. Va el HOST BASE sin /api y sin barra final:
# el script le pega /api/... solo (ej. /api/auth/login). El usuario es un usuario de
# SERVICIO de su sistema (cualquier rol autenticado alcanza; los endpoints
# /api/abastecimiento solo piden token, sin rol).
COMPANERO_API_URL=https://ordenes.laceleste.example
COMPANERO_API_USER=integracion-stocks
COMPANERO_API_PASS=cambiar
# `sync:recepciones` materializa RECEPCION (suma stock a FABRICA). El origen es el
# depósito del proveedor; por defecto el balde genérico 102 (DEPOSITO DE PROVEEDORES).
# Solo cambialo si querés imputar las recepciones a un acopio puntual.
RECEPCION_ORIGEN_DEP_ID_3C=102
# Piso de reconciliación de los syncs (YYYY-MM-DD, opcional). La ventana móvil NUNCA
# sincroniza fechas anteriores a este día → corte limpio con el histórico de 3c: lo
# <= piso lo cubre `import:movimientos` (con nro_3c) y el sync (sin nro_3c) sólo toca de
# ahí en adelante, sin duplicar. No afecta las cargas manuales --fecha/--desde/--hasta.
SYNC_PISO=2026-07-02

# --- Alertas / health-check (scripts\health-check.ps1, tarea "LaCeleste Health Check") ---
# Manda mail si el sync se cae, si una tarea queda deshabilitada, o si un producto
# regular deja de tener "real" en el origen. Usa SMTP (Gmail/Workspace con contraseña
# de aplicación). Dejar ALERT_SMTP_PASS vacío desactiva el envío (solo loguea).
ALERT_MAIL_TO=ia@laceleste.com.ar
ALERT_MAIL_FROM=ia@laceleste.com.ar
ALERT_SMTP_USER=ia@laceleste.com.ar
ALERT_SMTP_PASS=
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
# Días sin "real" para considerar que un producto regular "se cayó" (default 3).
DIAS_CAIDO=3
# Días de atraso del último movimiento del sync para alertar que no está entrando (default 2).
SYNC_STALE_DIAS=2

# --- Frontend ---
# URL del backend que usa el proxy de Vite en dev. Vacío = usa el default del proxy.
VITE_API_URL=
