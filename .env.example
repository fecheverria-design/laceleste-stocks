# ─────────────────────────────────────────────────────────────
# .env.example — copiar a .env y ajustar. Los .env reales NO se commitean.
# ─────────────────────────────────────────────────────────────

# --- PostgreSQL (lo consume docker-compose para crear la instancia) ---
POSTGRES_USER=laceleste
POSTGRES_PASSWORD=laceleste_dev
POSTGRES_DB=laceleste_movimientos
# Puerto del HOST (5433 para no chocar con un Postgres local en 5432)
POSTGRES_PORT=5433

# --- Backend ---
NODE_ENV=development
PORT=3000

# Conexión que usa el backend (apunta al puerto del host de arriba)
DATABASE_URL=postgresql://laceleste:laceleste_dev@localhost:5433/laceleste_movimientos

# Base de datos de test (Vitest). Se crea aparte sobre la misma instancia.
DATABASE_URL_TEST=postgresql://laceleste:laceleste_dev@localhost:5433/laceleste_movimientos_test

# Depósito que despacha por defecto cuando el POST /api/abastecimientos no manda
# origen_dep_id_3c. Es el dep_id de 3c del depósito principal (regla #1).
DEPOSITO_PRINCIPAL_DEP_ID_3C=1

# Auth JWT propio (Bearer + localStorage). Generar uno real con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambiar-por-un-secreto-de-32-bytes-minimo
JWT_EXPIRES_IN_SECONDS=28800

# --- Frontend ---
# URL del backend que usa el proxy de Vite en dev. Vacío = usa el default del proxy.
VITE_API_URL=
